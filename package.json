{
  "name": "agenda-livre-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend público do Agenda Livre (HTML, CSS e JavaScript puro).",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
