    "test:contract": "vitest run --config vitest.contract.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
